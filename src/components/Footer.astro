---
import footerData from '../data/footer.json';
import siteData from '../data/site.json';

const currentYear = new Date().getFullYear();
const copyrightText = footerData.copyright_text.replace('{year}', String(currentYear));
---

<footer class="bg-[#9dae9f] text-klang-cream mt-auto">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
      <!-- Brand -->
      <div class="space-y-4">
        <a 
          href="/" 
          class="hover:opacity-80 transition-opacity inline-block"
          aria-label={`${siteData.site_name} - Zur Startseite`}
        >
          <img 
            src={footerData.logo || '/logo2.png'} 
            alt={footerData.logo_alt || siteData.site_name} 
            class="h-12 md:h-14 w-auto rounded-lg"
          />
        </a>
        <p class="text-klang-cream/80 text-sm leading-relaxed" set:html={footerData.brand_text} />
      </div>
      
      <!-- Contact -->
      <div class="space-y-4">
        <h3 class="text-lg font-bold">{footerData.contact_heading}</h3>
        <address class="not-italic text-klang-cream/80 text-sm leading-relaxed space-y-2">
          <p>Eva Brandt</p>
          <p>
            <a 
              href={`tel:${siteData.phone}`} 
              class="hover:text-klang-cream transition-colors underline underline-offset-2"
              aria-label={`Telefonnummer anrufen: ${siteData.phone_display}`}
            >
              {siteData.phone_display}
            </a>
          </p>
          <p>
            <a 
              href={`mailto:${siteData.email}`} 
              class="hover:text-klang-cream transition-colors underline underline-offset-2"
              aria-label="E-Mail senden"
            >
              {siteData.email}
            </a>
          </p>
          <p set:html={`${siteData.address_street}<br />${siteData.address_city}`} />
        </address>
      </div>
      
      <!-- Links -->
      <div class="space-y-4">
        <h3 class="text-lg font-bold">{footerData.legal_heading}</h3>
        <nav aria-label="Footer Navigation">
          <ul class="space-y-2">
            {footerData.footer_links.map((link) => (
              <li>
                <a 
                  href={link.href}
                  class="text-klang-cream/80 text-sm hover:text-klang-cream transition-colors underline underline-offset-2"
                  aria-label={link.ariaLabel}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
    
    <!-- Bottom Bar -->
    <div class="border-t border-klang-cream/20 mt-8 pt-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-klang-cream/60 text-xs">
          {copyrightText}
        </p>
        <p class="text-klang-cream/60 text-xs">
          {footerData.credits_text}
        </p>
      </div>
    </div>
  </div>
</footer>
