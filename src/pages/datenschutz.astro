---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const legalPages = await Astro.glob('../content/*.md');
const datenschutz = legalPages.find(p => p.file.includes('datenschutz'));
---

<Layout 
  title={datenschutz?.frontmatter.title ? `${datenschutz.frontmatter.title} | Klangraum in Balance` : "Datenschutz | Klangraum in Balance"}
  description={datenschutz?.frontmatter.description || "Datenschutzerklärung von Klangraum in Balance."}
>
  <Header />
  
  <main id="main-content">
    <!-- Page Header -->
    <section class="pt-16 md:pt-24 pb-8">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-xl md:text-2xl text-klang-green">
          {datenschutz?.frontmatter.title || "Datenschutzerklärung"}
        </h1>
      </div>
    </section>
    
    <!-- Content -->
    <section class="py-12 md:py-20">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="prose prose-lg max-w-none text-klang-green" set:html={datenschutz?.compiledContent()} />
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>
