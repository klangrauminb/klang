---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ueberMichData from '../data/ueber-mich.json';
---

<Layout 
  title={`${ueberMichData.page_title} | Klangraum in Balance`}
  description={ueberMichData.about_text.slice(0, 160) + "..."}
>
  <Header />
  
  <main id="main-content">
    <!-- Page Header -->
    <section class="pt-16 md:pt-24 pb-8">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-xl md:text-2xl text-klang-green">
          {ueberMichData.page_title}
        </h1>
      </div>
    </section>
    
    <!-- About Section -->
    <section 
      class="py-12 md:py-20"
      aria-labelledby="about-heading"
    >
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">
          <!-- Image -->
          <div class="order-1 lg:order-1 lg:mt-[4.5rem]">
            <div class="relative rounded-2xl overflow-hidden shadow-xl">
              <img 
                src={ueberMichData.about_image} 
                alt={ueberMichData.about_image_alt} 
                class="w-full h-auto object-cover"
                width="1149"
                height="1471"
                loading="lazy"
              />
            </div>
          </div>
          
          <!-- Text Content -->
          <div class="order-2 lg:order-2">
            <h2 
              id="about-heading"
              class="section-heading text-lg md:text-xl text-klang-green"
            >
              {ueberMichData.about_heading}
            </h2>
            <div class="prose prose-lg max-w-none">
              <p class="text-klang-green/90 text-lg md:text-xl leading-relaxed">
                {ueberMichData.about_text}
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- CTA Section -->
    <section 
      class="py-16 md:py-24 bg-[#5a6b5c] text-klang-cream"
      aria-labelledby="cta-heading"
    >
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 
          id="cta-heading"
          class="text-xl md:text-2xl text-klang-cream mb-8 max-w-2xl mx-auto"
        >
          {ueberMichData.cta_heading}
        </h2>
        <a 
          href="/kontakt/"
          class="inline-flex items-center justify-center px-8 py-4 bg-klang-cream text-[#5a6b5c] font-semibold rounded-lg hover:bg-klang-cream/90 transition-colors focus:outline-none focus:ring-2 focus:ring-klang-cream/50"
          aria-label={ueberMichData.cta_button}
        >
          {ueberMichData.cta_button}
        </a>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>
