---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import homeData from '../data/home.json';
---

<Layout 
  title={`${homeData.slogan} | Klangraum in Balance`}
  description={homeData.power_text.slice(0, 160) + "..."}
>
  <Header />
  
  <main id="main-content">
    <!-- Hero Section -->
    <section 
      class="relative w-full h-[70vh]"
      aria-label="Hero"
    >
      <img 
        src={homeData.hero_image} 
        alt={homeData.hero_alt} 
        class="w-full h-full object-cover"
        width="1920"
        height="1080"
        fetchpriority="high"
      />
      
      <!-- Scroll Indicator - Bottom Centered -->
      <a 
        href="#power-heading"
        class="absolute bottom-4 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white hover:text-white/90 transition-colors cursor-pointer group"
        aria-label="Zur Klangmassage Erklärung scrollen"
      >
        <span class="text-xs md:text-sm font-normal tracking-wide drop-shadow-lg bg-black/20 px-3 py-1.5 rounded-full backdrop-blur-sm whitespace-nowrap">{homeData.hero_scroll_text}</span>
        <svg 
          class="w-5 h-5 animate-bounce drop-shadow-lg" 
          fill="none" 
          stroke="currentColor" 
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path 
            stroke-linecap="round" 
            stroke-linejoin="round" 
            stroke-width="1.5" 
            d="M19 14l-7 7m0 0l-7-7m7 7V3" 
          />
        </svg>
      </a>
    </section>
    
    <!-- Slogan Section - Compact -->
    <section 
      class="py-6 md:py-8 bg-[#9dae9f]"
      aria-labelledby="slogan-heading"
    >
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 
          id="slogan-heading"
          class="text-lg md:text-xl lg:text-2xl text-klang-cream font-normal"
        >
          {homeData.slogan}
        </h1>
      </div>
    </section>
    
    <!-- Section 2: Die Kraft der Klangmassage -->
    <section 
      class="py-16 md:py-24 bg-white/50"
      aria-labelledby="power-heading"
    >
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start">
          <!-- Image - bündig mit Text -->
          <div class="order-1 lg:order-1 lg:mt-[9rem]">
            <div class="relative rounded-2xl overflow-hidden shadow-xl">
              <img 
                src={homeData.power_image} 
                alt={homeData.power_alt} 
                class="w-full h-auto object-cover"
                width="1920"
                height="1280"
                loading="lazy"
              />
            </div>
          </div>
          <!-- Text -->
          <div class="order-2 lg:order-2">
            <h2 
              id="power-heading"
              class="text-xl md:text-2xl text-klang-green font-bold mb-4 !border-0 !pb-0 !normal-case !tracking-normal text-justify"
            >
              {homeData.power_heading}
            </h2>
            <p class="text-klang-green/90 text-lg md:text-xl leading-relaxed">
              {homeData.power_text}
            </p>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Section 3: Besonders wohltuend bei -->
    <section 
      class="pt-8 md:pt-10 pb-16 md:pb-24"
      aria-labelledby="benefits-heading"
    >
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 
          id="benefits-heading"
          class="section-heading text-lg md:text-xl text-klang-green text-center"
        >
          Besonders wohltuend bei:
        </h2>
        <ul 
          class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6"
          role="list"
        >
          {homeData.benefits.map((benefit, index) => (
            <li class="flex items-start space-x-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-klang-sage/10 flex items-center justify-center mt-0.5">
                <svg 
                  class="w-4 h-4 text-klang-green" 
                  fill="currentColor" 
                  viewBox="0 0 20 20"
                  aria-hidden="true"
                >
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
              </span>
              <span class="text-klang-green/90 text-lg">{benefit}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
    
    <!-- CTA Section -->
    <section 
      class="py-16 md:py-24 bg-[#5a6b5c] text-klang-cream"
      aria-labelledby="cta-heading"
    >
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 
          id="cta-heading"
          class="text-lg md:text-xl mb-6 text-klang-cream"
        >
          {homeData.cta_heading}
        </h2>
        <p class="text-xl md:text-2xl text-klang-cream/90 mb-8 max-w-2xl mx-auto">
          {homeData.cta_text}
        </p>
        <a 
          href="/kontakt/"
          class="inline-flex items-center justify-center px-8 py-4 bg-klang-cream text-[#5a6b5c] font-semibold rounded-lg hover:bg-klang-cream/90 transition-colors focus:outline-none focus:ring-2 focus:ring-klang-cream/50"
          aria-label={homeData.cta_button}
        >
          {homeData.cta_button}
        </a>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>
